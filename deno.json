{
  "name": "pantry-info",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run main.ts",
    "import": "deno run --allow-net --allow-read --allow-write --allow-env main.ts import",
    "scrape": "deno run --allow-net --allow-read --allow-write --allow-env main.ts scrape",
    "pantry": "deno run --allow-net --allow-read --allow-write --allow-env main.ts pantry",
    "receive": "deno run --allow-net=127.0.0.1 --allow-read --allow-write --allow-env main.ts receive",
    "import-json": "deno run --allow-read --allow-write --allow-env main.ts import-json",
    "stats": "deno run --allow-read --allow-write --allow-env main.ts stats",
    "test": "deno test --allow-read --allow-write --allow-env tests/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.8"
  },
  "fmt": {
    "lineWidth": 96,
    "semiColons": true
  },
  "lock": false
}
